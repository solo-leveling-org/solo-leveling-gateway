extend type Query {
    me: User!
    user(id: Long!): User!
    userAdditionalInfo: UserAdditionalInfoResult!
    usersLeaderboard(
        paging: PagingInput!
        filter: LeaderboardFilterInput!
    ): UsersLeaderboardResult!
    userLeaderboard(filter: LeaderboardFilterInput!): LeaderboardUser!
}

extend type Mutation {
    updateUserLocale(locale: String!): Boolean!
}

# ── Domain types ─────────────────────────────────────────

type User {
    id: Long!
    username: String
    firstName: String!
    lastName: String
    photoUrl: String
    locale: String
    player: ProfilePlayer!
}

type UserAdditionalInfoResult {
    photoUrl: String
    dayStreak: DayStreak!
    locale: UserLocale!
    roles: [UserRole!]!
}

type UserLocale {
    tag: String!
    isManual: Boolean!
}

type LeaderboardUser {
    id: Long!
    firstName: String!
    lastName: String
    photoUrl: String
    score: String!
    position: Long!
}

# ── Input types ──────────────────────────────────────────

input LeaderboardFilterInput {
    type: LeaderboardType!
    range: DayRangeInput
}

# ── Result types ─────────────────────────────────────────

type UsersLeaderboardResult {
    users: [LeaderboardUser!]!
    paging: ResponsePaging!
}

# ── Enums ────────────────────────────────────────────────

enum UserRole {
    USER
    ADMIN
    DEVELOPER
    MANAGER
}

enum LeaderboardType {
    TASKS
    BALANCE
    LEVEL
}
