extend type Query {
    balance: Balance!
    searchBalanceTransactions(
        paging: PagingInput!
        options: SearchOptionsInput
    ): SearchBalanceTransactionsResult!
}

# ── Domain types ─────────────────────────────────────────

type Balance {
    id: UUID!
    balance: Money!
}

type BalanceTransaction {
    id: String!
    amount: Money!
    type: BalanceTransactionType!
    cause: BalanceTransactionCause!
    createdAt: DateTime!
}

# ── Result types ─────────────────────────────────────────

type SearchBalanceTransactionsResult {
    transactions: [BalanceTransaction!]!
    paging: ResponsePaging!
    options: ResponseQueryOptions
}

# ── Enums ────────────────────────────────────────────────

enum BalanceTransactionType {
    IN
    OUT
}

enum BalanceTransactionCause {
    TASK_COMPLETION
    LEVEL_UP
    DAILY_CHECK_IN
    ITEM_PURCHASE
}
