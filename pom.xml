<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.2</version>
  </parent>

  <groupId>com.soloist</groupId>
  <artifactId>soloist-gateway</artifactId>
  <version>2.1.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>soloist-gateway-api</module>
    <module>soloist-gateway-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.grpc</groupId>
        <artifactId>spring-grpc-dependencies</artifactId>
        <version>${spring-grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven-compliler.version>3.15.0</maven-compliler.version>

    <!-- kotlin -->
    <kotlin.version>2.3.10</kotlin.version>
    <kotlin.code.style>official</kotlin.code.style>
    <kotlinx-coroutines.version>1.10.2</kotlinx-coroutines.version>

    <!-- native build -->
    <native-maven-plugin.version>0.11.0</native-maven-plugin.version>

    <!-- graphql -->
    <graphql-java.version>25.0</graphql-java.version>
    <graphql-java-extended-scalars.version>24.0</graphql-java-extended-scalars.version>
    <graphql-codegen.version>3.7.1</graphql-codegen.version>

    <!-- grpc -->
    <spring-grpc.version>1.0.2</spring-grpc.version>

    <!-- utils -->
    <bcprov-jdk15on.version>1.70</bcprov-jdk15on.version>
    <jjwt.version>0.13.0</jjwt.version>

    <!-- mapstruct -->
    <mapstruct.version>1.6.3</mapstruct.version>

    <!-- soloist -->
    <soloist-lib.version>2.1.0.15</soloist-lib.version>

    <!-- tests -->
    <test-containers.version>2.0.3</test-containers.version>
    <mockito-kotlin.version>5.1.0</mockito-kotlin.version>
  </properties>
</project>
